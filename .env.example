# Runtime connection. MUST be the non-superuser `bos_app` role so row level security applies.
DATABASE_URL=postgres://bos_app:CHANGE_ME@localhost:5432/bos
# Owner/admin connection. Only used for migrations and first-time seed.
DATABASE_ADMIN_URL=postgres://bos_admin:CHANGE_ME@localhost:5432/bos
# Sets the bos_app login password during `npm run db:migrate` (optional).
APP_DB_PASSWORD=
# Public URL of the app (used in invoice/quote links and webhooks).
APP_URL=http://localhost:3000
# 32+ random characters. Encrypts integration secrets (Stripe keys, SMTP passwords...). Never change once set.
ENCRYPTION_KEY=
# Where uploaded documents/photos are stored.
STORAGE_DIR=./storage
# Optional: platform-wide SMTP fallback, e.g. smtp://user:pass@smtp.example.com:587?from=hello@example.com
SMTP_URL=
# Optional: AI assistant key if not connected in Settings -> Integrations.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Optional: Google OAuth app for Gmail + Google Calendar connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# First-run owner login created by `npm run db:seed`.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
SEED_OWNER_NAME=Owner
SEED_ACCOUNT_NAME=My Businesses
# 1 = also load fake demo customers, quotes, invoices, jobs (for showing the app). Leave blank for real use.
SEED_DEMO=
# docker compose only
POSTGRES_ADMIN_PASSWORD=
